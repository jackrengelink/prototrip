# Copy this file to .env and fill in whichever keys you have. ALL OPTIONAL.
# With nothing set, ProtoTrip already has live Ryanair fares, Wikipedia + Wikivoyage
# things to do and Open-Meteo weather. See API-KEYS.md for how to get each key and its limits.

PORT=5173

# Flights ---------------------------------------------------------------
# Ryanair's public fare finder: live, no key. Set to "off" to disable it.
RYANAIR=on

# RECOMMENDED: every other airline (Transavia, easyJet, Wizz, KLM, long-haul).
# Free, 300-600 requests/minute. https://www.travelpayouts.com -> Profile -> API token
TRAVELPAYOUTS_TOKEN=
# Optional affiliate id: bookings through ProtoTrip links earn a small commission
TRAVELPAYOUTS_MARKER=

# Optional: live Google Flights checks (~250 free searches/month).
# https://serpapi.com/users/sign_up
SERPAPI_KEY=

# Things to do (only used when someone clicks "What to do?") ------------
# Optional extra restaurants/bars from OpenStreetMap. 3,000 credits/day.
# https://myprojects.geoapify.com
GEOAPIFY_KEY=

# Optional bookable tours. Free "Basic Access" affiliate key.
# https://partnerresources.viator.com
VIATOR_KEY=

# Contact address sent in the User-Agent to Wikipedia/Wikivoyage (their API policy asks for one)
CONTACT_EMAIL=